<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studynote.notes.mapper.PaymentMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="paymentId"
            parameterType="com.studynote.notes.model.entity.Payment">
        INSERT INTO payment (order_id, user_id, amount, channel, status, pay_time)
        VALUES (#{orderId}, #{userId}, #{amount}, #{channel}, #{status}, NOW())
    </insert>

    <select id="findByOrderId" resultType="com.studynote.notes.model.entity.Payment">
        SELECT *
        FROM payment
        WHERE order_id = #{orderId}
    </select>

</mapper>
