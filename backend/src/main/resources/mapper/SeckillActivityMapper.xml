<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studynote.notes.mapper.SeckillActivityMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="activityId"
            parameterType="com.studynote.notes.model.entity.SeckillActivity">
        INSERT INTO seckill_activity (course_id, seckill_price, stock, start_time, end_time, status)
        VALUES (#{courseId}, #{seckillPrice}, #{stock}, #{startTime}, #{endTime}, #{status})
    </insert>

    <select id="activityList" resultType="com.studynote.notes.model.entity.SeckillActivity">
        SELECT *
        FROM seckill_activity
        ORDER BY activity_id DESC
    </select>

    <select id="findById" resultType="com.studynote.notes.model.entity.SeckillActivity">
        SELECT *
        FROM seckill_activity
        WHERE activity_id = #{activityId}
    </select>

    <update id="update" parameterType="com.studynote.notes.model.entity.SeckillActivity">
        UPDATE seckill_activity
        <set>
            <if test="courseId != null">
                course_id = #{courseId},
            </if>
            <if test="seckillPrice != null">
                seckill_price = #{seckillPrice},
            </if>
            <if test="stock != null">
                stock = #{stock},
            </if>
            <if test="startTime != null">
                start_time = #{startTime},
            </if>
            <if test="endTime != null">
                end_time = #{endTime},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        WHERE activity_id = #{activityId}
    </update>

    <delete id="deleteById">
        DELETE
        FROM seckill_activity
        WHERE activity_id = #{activityId}
    </delete>
    <update id="deductStock">
        update
        seckill_activity
        set stock  = stock  -1
        where activity_id = #{activityId}
        and stock > 0
    </update>
    <update id="addStock">
        update
        seckill_activity
        set stock = stock + 1
        where activity_id = #{activityId}
    </update>

    <!--
      【对账】候选活动：当前【不在】秒杀时间窗口内的活动。

        "不在窗口内" = 已经结束 (end_time < now) 或 还没开始 (start_time > now)
        换句话说，正在进行中的活动被【刻意排除】在外 ——
        理由见 SeckillService#reconcileOne 的注释（DEL 集合的窗口 + MySQL stock 滞后），
        这是正确性要求，不是性能优化。改动这个 WHERE 之前先把那段读完。

        from 是时间下界：只修"最近结束"的活动，避免每轮都把全部历史活动空刷一遍。
        对于"还没开始"的活动，它的 end_time 必然在将来，天然满足 end_time > from。
    -->
    <select id="findReconcileCandidates" resultType="java.lang.Integer">
        SELECT activity_id
        FROM seckill_activity
        WHERE (end_time &lt; #{now} OR start_time &gt; #{now})
          AND end_time &gt; #{from}
        ORDER BY activity_id
        LIMIT #{limit}
    </select>
</mapper>
